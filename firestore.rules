rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contador de pedidos: qualquer pessoa pode ler o valor atual (necessário
    // pra transação funcionar). Só pode incrementar de 1 em 1 dentro do mesmo
    // dia (nunca pular número nem diminuir), OU reiniciar pra 1 quando a data
    // muda (primeiro pedido de um novo dia).
    match /counters/orders {
      allow get: if true;
      allow create: if request.resource.data.current == 1 && request.resource.data.date is string;
      allow update: if request.resource.data.date is string
        && ((request.resource.data.current == resource.data.get('current', 0) + 1 && request.resource.data.date == resource.data.get('date', null))
          || (request.resource.data.current == 1 && request.resource.data.date != resource.data.get('date', null)));
      allow delete: if false;
    }

    // Pedidos: qualquer cliente pode CRIAR um pedido novo pelo site (checkout
    // público), mas só se os dados tiverem tipo e tamanho plausíveis — evita
    // alguém escrever direto no banco (fora do site) com preço inventado ou
    // data falsa pra bagunçar o painel. Só o admin autenticado (login do
    // painel) pode ler, editar ou apagar — ninguém de fora enxerga os
    // pedidos de outras pessoas.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly(['items', 'subtotal', 'deliveryFee', 'total', 'deliveryType', 'location', 'cutlery', 'paymentMethod', 'notes', 'orderNumber', 'createdAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.subtotal <= 5000
        && (request.resource.data.deliveryFee == 0 || request.resource.data.deliveryFee == 7)
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 5000
        && request.resource.data.deliveryType in ['retirada', 'entrega']
        && request.resource.data.cutlery in ['hashi', 'garfo', 'nenhum']
        && request.resource.data.paymentMethod in ['pix', 'cartao', 'dinheiro']
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 300
        && request.resource.data.orderNumber is int
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if request.auth != null;
    }

    // Fotos do carrossel: qualquer visitante do site pode ver (pra aparecer
    // pro público), mas só o admin autenticado pode adicionar/remover.
    match /carouselImages/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Itens esgotados: qualquer visitante do site precisa ler essa lista pra
    // saber o que esconder do cardápio, mas só o admin autenticado marca ou
    // desmarca um item.
    match /menuStatus/soldOut {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tudo que não foi listado acima continua bloqueado por padrão.
  }
}
